{
  "ConnectionStrings": {
    "PostgreSql": "",
    "Redis": "localhost:6379"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Swagger": {
    "EnabledInProduction": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "Jwt": {
    "Issuer": "LiveMetricStack",
    "Audience": "LiveMetricStack.Client",
    "Key": "dev-only-super-secret-key-at-least-32-chars",
    "ExpirationMinutes": 120
  },
  "MetricsGenerator": {
    "Enabled": true,
    "IntervalSeconds": 3
  },
  "MetricsRetention": {
    "Enabled": true,
    "RetentionDays": 7,
    "IntervalMinutes": 30
  },
  "HealthMonitor": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "TimeoutSeconds": 5,
    "Targets": []
  },
  "Cache": {
    "EnableRedis": false,
    "MetricsTtlSeconds": 5,
    "DashboardTtlSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
