{
  "ConnectionStrings": {
    "PostgreSql": "",
    "Redis": "localhost:6379"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Swagger": {
    "EnabledInProduction": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "Jwt": {
    "Issuer": "LiveMetricStack",
    "Audience": "LiveMetricStack.Client",
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32CHARS_MIN",
    "ExpirationMinutes": 120
  },
  "MetricsGenerator": {
    "Enabled": true,
    "IntervalSeconds": 5
  },
  "MetricsRetention": {
    "Enabled": true,
    "RetentionDays": 30,
    "IntervalMinutes": 60
  },
  "HealthMonitor": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "TimeoutSeconds": 5,
    "Targets": []
  },
  "Cache": {
    "EnableRedis": false,
    "MetricsTtlSeconds": 10,
    "DashboardTtlSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
