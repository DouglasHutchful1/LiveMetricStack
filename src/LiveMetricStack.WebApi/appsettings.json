{
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=livemetricstack;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "LiveMetricStack",
    "Audience": "LiveMetricStack.Client",
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32CHARS_MIN",
    "ExpirationMinutes": 120
  },
  "MetricsGenerator": {
    "Enabled": true,
    "IntervalSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
